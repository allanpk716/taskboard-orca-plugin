{
  "name": "taskboard-dsh",
  "version": "0.2.0-mvp",
  "private": true,
  "type": "module",
  "description": "工单板的 DSH 插件（MVP：三类筛选面板 + 标已读 + 断开 + 系统通知）",
  "main": "index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
